<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Гра Змійка</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0d1117; /* Темний фон */
            color: #c9d1d9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .game-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #161b22; /* Фон контейнера */
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            max-width: 450px;
            width: 100%;
        }

        h1 {
            color: #58a6ff;
            margin-bottom: 10px;
            font-size: 1.8rem;
        }

        #score {
            font-size: 1.2rem;
            margin-bottom: 20px;
            font-weight: 700;
        }

        canvas {
            border: 4px solid #30363d;
            background-color: #010409; /* Фон ігрового поля */
            border-radius: 8px;
            touch-action: none; /* Відключаємо типові дії дотику */
            width: 100%; /* Адаптивна ширина */
            max-width: 400px;
            aspect-ratio: 1 / 1; /* Квадратне поле */
        }

        .message-box {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            display: none; /* Приховано за замовчуванням */
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            text-align: center;
        }

        .message-box-content {
            background-color: #21262d;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 30px rgba(88, 166, 255, 0.4);
            max-width: 90%;
            animation: fadeIn 0.3s ease-out;
        }

        .message-box h2 {
            color: #f0f6fc;
            margin-top: 0;
            font-size: 2rem;
        }

        .message-box p {
            margin: 15px 0;
            font-size: 1.1rem;
        }

        .btn {
            background-color: #238636;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 700;
            transition: background-color 0.2s, transform 0.1s;
            box-shadow: 0 3px 0 #1b6d28;
            margin-top: 20px;
        }

        .btn:hover {
            background-color: #2ea043;
        }

        .btn:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #1b6d28;
        }

        .controls-info {
            margin-top: 20px;
            font-size: 0.9rem;
            color: #8b949e;
            text-align: center;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</head>
<body>

    <div class="game-container">
        <h1>Змійка (Snake)</h1>
        <div id="score">Рахунок: 0</div>
        <canvas id="gameCanvas" width="400" height="400"></canvas>
        <div class="controls-info">
            <p>Керування: Клавіші зі стрілками (↑↓←→)</p>
            <p>Натисніть "Почати гру" або стрілку, щоб почати.</p>
        </div>
    </div>

    <div id="messageBox" class="message-box">
        <div class="message-box-content">
            <h2 id="messageTitle"></h2>
            <p id="messageText"></p>
            <button id="restartButton" class="btn">Перезапустити</button>
        </div>
    </div>

    <script>
        // Ініціалізація змінних
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreDisplay = document.getElementById('score');
        const messageBox = document.getElementById('messageBox');
        const messageTitle = document.getElementById('messageTitle');
        const messageText = document.getElementById('messageText');
        const restartButton = document.getElementById('restartButton');

        // Конфігурація гри
        const TILE_SIZE = 20;
        const TILE_COUNT = canvas.width / TILE_SIZE; // 20x20 поле
        let snake = [];
        let food = {};
        let dx = TILE_SIZE; // Напрямок по X
        let dy = 0;        // Напрямок по Y
        let score = 0;
        let gameInterval;
        let gameSpeed = 100; // Швидкість в мілісекундах
        let gameStarted = false;
        let nextDx = TILE_SIZE;
        let nextDy = 0;

        // Ініціалізувати гру
        function initGame() {
            snake = [{ x: 6 * TILE_SIZE, y: 6 * TILE_SIZE }]; // Початкова позиція змійки
            dx = TILE_SIZE;
            dy = 0;
            nextDx = TILE_SIZE;
            nextDy = 0;
            score = 0;
            scoreDisplay.textContent = `Рахунок: ${score}`;
            gameStarted = false;
            clearInterval(gameInterval);
            placeFood();
            drawGame();
            showMessage('Гра Змійка', 'Використовуйте клавіші зі стрілками для керування. Натисніть "Перезапустити" або стрілку, щоб почати.', true);
        }

        // Відображення повідомлення (заміна alert)
        function showMessage(title, text, isPreStart = false) {
            messageTitle.textContent = title;
            messageText.innerHTML = text; // Використовуємо innerHTML для підтримки <br>
            restartButton.textContent = isPreStart ? 'Почати гру' : 'Перезапустити';
            restartButton.onclick = isPreStart ? startGame : restartGame;
            messageBox.style.display = 'flex';
        }

        // Запуск гри
        function startGame() {
            if (gameStarted) return;
            gameStarted = true;
            messageBox.style.display = 'none';
            gameInterval = setInterval(gameLoop, gameSpeed);
        }

        // Перезапуск гри
        function restartGame() {
            messageBox.style.display = 'none';
            initGame();
            startGame();
        }

        // Розміщення їжі у випадковій клітинці
        function placeFood() {
            let newFood;
            do {
                const randomX = Math.floor(Math.random() * TILE_COUNT) * TILE_SIZE;
                const randomY = Math.floor(Math.random() * TILE_COUNT) * TILE_SIZE;
                newFood = { x: randomX, y: randomY };
            } while (isPositionOnSnake(newFood));

            food = newFood;
        }

        // Перевірка, чи позиція збігається з тілом змійки
        function isPositionOnSnake(pos) {
            return snake.some(segment => segment.x === pos.x && segment.y === pos.y);
        }

        // Оновлення стану гри
        function updateGame() {
            // Застосовуємо оновлений напрямок
            dx = nextDx;
            dy = nextDy;

            // Створюємо нову голову
            const head = { x: snake[0].x + dx, y: snake[0].y + dy };

            // Перевірка на зіткнення зі стінами
            if (head.x < 0 || head.x >= canvas.width || head.y < 0 || head.y >= canvas.height) {
                gameOver('Зіткнення зі стіною!');
                return;
            }

            // Перевірка на зіткнення з власним тілом (починаємо з 4-го сегмента, щоб уникнути помилки з рухом назад)
            if (isPositionOnSnake(head)) {
                gameOver('Зіткнення із власним хвостом!');
                return;
            }

            // Додаємо нову голову до початку змійки
            snake.unshift(head);

            // Перевірка на поїдання їжі
            if (head.x === food.x && head.y === food.y) {
                score += 10;
                scoreDisplay.textContent = `Рахунок: ${score}`;
                placeFood(); // Розміщуємо нову їжу
                // Збільшуємо швидкість (трохи)
                if (score % 50 === 0 && gameSpeed > 50) {
                     gameSpeed -= 5;
                     clearInterval(gameInterval);
                     gameInterval = setInterval(gameLoop, gameSpeed);
                }

            } else {
                snake.pop(); // Видаляємо останній сегмент, якщо їжа не з'їдена (рух)
            }
        }

        // Кінець гри
        function gameOver(reason) {
            gameStarted = false;
            clearInterval(gameInterval);
            const finalScore = score;
            showMessage('Гру закінчено!', `Причина: ${reason}<br>Ваш фінальний рахунок: ${finalScore}`, false);
        }

        // Обробка вводу з клавіатури
        document.addEventListener('keydown', (event) => {
            const key = event.key;
            let newDx = nextDx;
            let newDy = nextDy;

            switch (key) {
                case 'ArrowLeft':
                    newDx = -TILE_SIZE;
                    newDy = 0;
                    break;
                case 'ArrowUp':
                    newDx = 0;
                    newDy = -TILE_SIZE;
                    break;
                case 'ArrowRight':
                    newDx = TILE_SIZE;
                    newDy = 0;
                    break;
                case 'ArrowDown':
                    newDx = 0;
                    newDy = TILE_SIZE;
                    break;
                default:
                    return; // Ігноруємо інші клавіші
            }

            // Запобігаємо руху назад (на 180 градусів)
            // Дозволяємо лише якщо новий напрямок не є протилежним поточному
            if (newDx !== -dx || newDy !== -dy) {
                nextDx = newDx;
                nextDy = newDy;
            }

            // Якщо гра не почата, починаємо її першим натисканням
            if (!gameStarted) {
                startGame();
            }

            event.preventDefault(); // Запобігаємо прокручуванню сторінки
        });

        // Малювання гри
        function drawGame() {
            // Очищення поля
            ctx.fillStyle = '#010409';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Малювання їжі (Червоний квадрат)
            ctx.fillStyle = '#ff4d4d';
            ctx.fillRect(food.x, food.y, TILE_SIZE, TILE_SIZE);
            ctx.strokeStyle = '#010409';
            ctx.strokeRect(food.x, food.y, TILE_SIZE, TILE_SIZE);


            // Малювання змійки
            snake.forEach((segment, index) => {
                // Голова - світліше зелений, тіло - темніше
                if (index === 0) {
                    ctx.fillStyle = '#2ea043'; // Голова
                } else {
                    ctx.fillStyle = '#238636'; // Тіло
                }
                ctx.fillRect(segment.x, segment.y, TILE_SIZE, TILE_SIZE);

                // Додаємо чорний контур для кращого розділення
                ctx.strokeStyle = '#010409';
                ctx.strokeRect(segment.x, segment.y, TILE_SIZE, TILE_SIZE);
            });
        }

        // Основний цикл гри
        function gameLoop() {
            updateGame();
            drawGame();
        }

        // Запуск ініціалізації при завантаженні сторінки
        window.onload = initGame;

    </script>
</body>
</html>
